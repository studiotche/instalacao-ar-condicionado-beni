---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteWizard from "../components/QuoteWizard.astro";
import { siteData, buildWhatsAppUrl } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string): string => `${base}${path.replace(/^\//, "")}`;
---
<BaseLayout>
  <!-- Application Mount Target -->
  <div id="app" class="flex flex-col min-h-screen">
        <!-- Main Header (Fixo com Alto Desempenho) -->
    <header id="main-header" class="site-header">
      <div class="header-container">
        <!-- Logo -->
        <a href="#" class="header-logo-link" aria-label={`${siteData.company.name} - Início`}>
          <img 
            src={asset("/assets/images/logo-beni.webp")} 
            alt={siteData.company.name} 
            class="header-brand-logo" 
            width="176" 
            height="58" 
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="header-desktop-nav" aria-label="Navegação Principal">
          {siteData.navigation.map((item) => (
            <a href={item.href} class="header-nav-link">
              {item.label}
            </a>
          ))}
        </nav>

        <!-- CTA & Mobile Menu Toggle -->
        <div class="header-actions">
          <button type="button" data-open-quote class="header-cta-btn header-cta-desktop">
            <span>Solicitar orçamento</span>
            <svg class="btn-icon-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>

          <button id="mobile-menu-toggle" type="button" class="mobile-menu-btn" aria-label="Abrir menu de navegação" aria-expanded="false">
            <svg class="icon-menu" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-backdrop" class="mobile-backdrop" style="background-color: rgba(2, 6, 23, 0.85); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"></div>
    <div id="mobile-drawer" class="mobile-drawer">
      <div>
        <div class="mobile-drawer-header">
          <a href="#" class="header-logo-link" aria-label={`${siteData.company.name} - Início`}>
            <img 
              src={asset("/assets/images/logo-beni.webp")} 
              alt={siteData.company.name} 
              class="header-brand-logo" 
              width="176" 
              height="58" 
            />
          </a>
          <button id="mobile-menu-close" type="button" class="mobile-menu-close-btn" aria-label="Fechar menu">
            <svg class="icon-menu" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="mobile-drawer-nav" aria-label="Navegação móvel">
          {siteData.navigation.map((item) => (
            <a href={item.href} class="mobile-nav-link-custom">
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <div class="mobile-drawer-footer">
        <button type="button" data-open-quote class="header-cta-btn mobile-cta-btn">
          <span>Solicitar orçamento</span>
          <svg class="btn-icon-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
        <p class="mobile-drawer-location">{siteData.company.locationString}</p>
      </div>
    </div>

    <!-- Conteúdo Principal -->
    <main id="conteudo-principal">
      
      <!-- Hero Section -->
      <section class="hero-section" aria-labelledby="hero-title">
        <!-- Imagem de Fundo Integrada (Largura Total) -->
        <div class="hero-bg-desktop">
          <picture class="hero-picture">
            <source media="(max-width: 1023px)" srcset={asset(siteData.hero.imageMobile.url)} />
            <img 
              src={asset(siteData.hero.image.url)} 
              alt={siteData.hero.image.alt} 
              loading="eager"
              fetchpriority="high"
              width={siteData.hero.image.width}
              height={siteData.hero.image.height}
              class="hero-img-full"
            />
          </picture>
        </div>

        <div class="hero-container">
          <div class="hero-grid">
            <div class="hero-copy-container">
              <span class="hero-eyebrow">
                {siteData.hero.eyebrow}
              </span>

              <h1 id="hero-title" class="hero-title">
                {siteData.hero.headlinePart1}<br class="hero-br-mobile" /> {siteData.hero.headlinePart2} 
                <span class="hero-title-highlight">{siteData.hero.headlineHighlight}</span>
              </h1>

              <p class="hero-description">
                {siteData.hero.description}
              </p>

              <div class="hero-actions">
                <button type="button" data-open-quote class="btn-primary hero-btn-primary">
                  <span>{siteData.hero.primaryCta}</span>
                  <svg class="btn-icon-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </button>
                
                <a href="#servicos" class="link-editorial hero-btn-secondary group">
                  <span>{siteData.hero.secondaryCta}</span>
                  <svg class="hero-btn-icon-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>

              <div class="hero-badge">
                <svg class="hero-badge-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <div class="hero-badge-text">
                  <span>Atendimento em <span class="hero-badge-highlight">{siteData.company.city}/{siteData.company.state} e região</span></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Trust Bar -->
      <section class="trust-bar-section" aria-label="Diferenciais e Padrão de Atendimento">
        <div class="reveal-fade trust-bar-container">
          <div class="trust-bar-grid">
            
            {siteData.trustBar.map((item, index) => (
              <div class={`trust-bar-item group ${index === 0 ? "trust-bar-item-first" : index === 3 ? "trust-bar-item-last" : "trust-bar-item-middle"}`}>
                <div class="trust-bar-icon-wrapper">
                  {item.icon === "tool" && (
                    <svg class="trust-bar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                  )}
                  {item.icon === "gear" && (
                    <svg class="trust-bar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                  )}
                  {item.icon === "team" && (
                    <svg class="trust-bar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                  {item.icon === "location" && (
                    <svg class="trust-bar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  )}
                </div>
                <div class="trust-bar-content">
                  <div class="trust-bar-title">
                    {item.title}
                  </div>
                  <p class="trust-bar-desc">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}

          </div>
        </div>
      </section>

      <!-- Serviços -->
      <section id="servicos" class="services-section" aria-labelledby="servicos-title">
        <div class="services-container">
          
          <div class="services-grid">
            
            <!-- Coluna Esquerda -->
            <div class="services-left-col">
              <span class="services-eyebrow reveal-up">{siteData.services.eyebrow}</span>
              <h2 id="servicos-title" class="services-title reveal-up" style="transition-delay: 80ms;">
                {siteData.services.title}
              </h2>
              <p class="services-desc reveal-up" style="transition-delay: 140ms;">
                {siteData.services.description}
              </p>

              <!-- Fotografia Técnica Integrada (Desktop) -->
              <div class="services-featured-img-wrapper reveal-scale" style="transition-delay: 180ms;">
                <img 
                  id="service-featured-img"
                  src={asset(siteData.services.items[0].image)} 
                  alt={siteData.services.items[0].alt} 
                  class="services-featured-img"
                  loading="lazy"
                  width="440"
                  height="586"
                />
              </div>
            </div>

            <!-- Lado Direito Desktop -->
            <div class="services-right-col-desktop">
              {siteData.services.items.map((svc, idx) => (
                <article class="service-item reveal-up" data-service-img={asset(svc.image)} style={`transition-delay: ${idx * 60}ms;`}>
                  <div class="service-item-header" data-service-trigger>
                    
                    <div class="service-item-content-wrapper">
                      <span class="service-item-number">{svc.number}</span>
                      <div>
                        <div class="service-item-title-wrapper">
                          <h3 class="service-item-title">
                            {svc.title}
                          </h3>
                          <span class="service-item-tag">{svc.tag}</span>
                        </div>
                        <p class="service-item-desc">
                          {svc.description}
                        </p>
                      </div>
                    </div>

                    <div class="service-item-action-wrapper">
                      <button type="button" data-open-quote data-service={svc.title} class="service-item-action-btn" aria-label={`Orçar ${svc.title}`}>
                        <svg class="service-item-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </button>
                    </div>

                  </div>
                </article>
              ))}
            </div>

            <!-- Lado Mobile: Accordion Limpo -->
            <div class="services-right-col-mobile">
              {siteData.services.items.map((svc, idx) => (
                <details class="service-accordion" open={idx === 0}>
                  <summary class="service-accordion-summary">
                    <div class="service-accordion-header">
                      <span class="service-accordion-number">{svc.number}</span>
                      <h3 class="service-accordion-title">
                        {svc.title}
                      </h3>
                    </div>
                    <div class="service-accordion-icon-wrapper">
                      <svg class="service-accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </summary>
                  
                  <div class="service-accordion-content">
                    <div>
                      <span class="service-accordion-tag">
                        {svc.tag}
                      </span>
                    </div>
                    
                    <p class="service-accordion-desc">
                      {svc.description}
                    </p>

                    <div class="service-accordion-img-wrapper">
                      <img 
                        src={asset(svc.image)} 
                        alt={svc.alt} 
                        class="service-accordion-img"
                        loading="lazy"
                        width="400"
                        height="500"
                      />
                    </div>

                    <div class="service-accordion-action">
                      <button type="button" data-open-quote data-service={svc.title} class="btn-primary service-accordion-btn">
                        <span>Solicitar orçamento</span>
                        <svg class="btn-icon-arrow service-accordion-btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </button>
                    </div>
                  </div>
                </details>
              ))}
            </div>

          </div>

        </div>
      </section>

      <!-- Padrão de Instalação (Dark Editorial) -->
      <section id="instalacao" class="install-section" aria-labelledby="install-title">
        <div class="install-container">
          <div class="install-grid">
            
            <div class="install-img-wrapper reveal-scale">
              <img 
                src={asset(siteData.installation.image.url)} 
                alt={siteData.installation.image.alt} 
                class="install-img"
                loading="lazy"
                width={siteData.installation.image.width}
                height={siteData.installation.image.height}
              />
            </div>

            <div class="install-content-wrapper">
              <h2 id="install-title" class="install-title reveal-up">
                {siteData.installation.headline}
              </h2>
              <p class="install-desc reveal-up" style="transition-delay: 80ms;">
                {siteData.installation.text}
              </p>
              
              <div class="install-pillars-grid">
                {siteData.installation.pillars.map((pillar, idx) => (
                  <div class="install-pillar reveal-up" style={`transition-delay: ${idx * 70}ms;`}>
                    <h3 class="install-pillar-title">{pillar.title}</h3>
                    <p class="install-pillar-desc">{pillar.description}</p>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Processo ("Como trabalhamos") -->
      <section id="processo" class="process-section" aria-labelledby="processo-title">
        <div class="process-container">
          
          <div class="process-header">
            <span class="process-eyebrow reveal-up">{siteData.process.eyebrow}</span>
            <h2 id="processo-title" class="process-title reveal-up" style="transition-delay: 80ms;">
              {siteData.process.headline}
            </h2>
            <p class="process-desc reveal-up" style="transition-delay: 140ms;">
              {siteData.process.description}
            </p>
          </div>

          <!-- Desktop Flow -->
          <div class="process-desktop-flow">
            <div class="process-line-track">
               <div class="process-line-fill reveal-line-x"></div>
            </div>

            <div class="process-steps-row">
              {siteData.process.steps.map((step, idx) => (
                <article class="process-step-item reveal-up group" data-step-index={idx} style={`transition-delay: ${200 + idx * 120}ms;`}>
                  <div class="process-step-hover-line"></div>
                  <span class="process-step-number">
                    {step.number}
                  </span>
                  <h3 class="process-step-title">
                    {step.title}
                  </h3>
                  <p class="process-step-desc">
                    {step.description}
                  </p>
                </article>
              ))}
            </div>
          </div>

          <!-- Mobile Flow -->
          <div class="process-mobile-flow">
            {siteData.process.steps.map((step, idx) => (
              <article class="process-mobile-item reveal-up" style={`transition-delay: ${100 + idx * 120}ms;`}>
                <div class="process-mobile-icon-wrapper">
                  <span class="process-mobile-number">
                    {step.number}
                  </span>
                  {idx < siteData.process.steps.length - 1 && (
                    <div class="process-mobile-line-track">
                       <div class="process-mobile-line-fill reveal-line-y" style={`transition-delay: ${200 + idx * 120}ms;`}></div>
                    </div>
                  )}
                </div>

                <div class="process-mobile-content">
                  <h3 class="process-mobile-title">
                    {step.title}
                  </h3>
                  <p class="process-mobile-desc">
                    {step.description}
                  </p>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- Soluções Sob Medida (Residencial e Empresarial) -->
      <section id="solucoes" class="solutions-section" aria-labelledby="solucoes-title">
        <div class="solutions-container">
          
          <div class="solutions-header">
            <span class="solutions-eyebrow reveal-up">{siteData.solutions.eyebrow}</span>
            <h2 id="solucoes-title" class="solutions-title reveal-up" style="transition-delay: 80ms;">
              {siteData.solutions.title}
            </h2>
            <p class="solutions-desc reveal-up" style="transition-delay: 140ms;">
              {siteData.solutions.description}
            </p>
          </div>

          <div class="solutions-list">
            
            <!-- Bloco 1: Residencial -->
            <article class="solutions-article" aria-labelledby="res-title">
              <div class="solutions-img-col reveal-scale solutions-img-res">
                <div class="solutions-img-wrapper">
                  <img 
                    src={asset(siteData.solutions.residential.image)} 
                    alt={siteData.solutions.residential.alt} 
                    class="solutions-img"
                    loading="lazy"
                    width="640"
                    height="480"
                  />
                </div>
              </div>

              <div class="solutions-content-col reveal-up solutions-content-res">
                <span class="solutions-badge">
                  {siteData.solutions.residential.badge}
                </span>
                <h3 id="res-title" class="solutions-article-title">
                  {siteData.solutions.residential.headline}
                </h3>
                <p class="solutions-article-desc">
                  {siteData.solutions.residential.text}
                </p>

                <ul class="solutions-highlights">
                  {siteData.solutions.residential.highlights.map((item) => (
                    <li class="solutions-highlight-item">
                      <span class="solutions-highlight-dot"></span>
                      <span class="solutions-highlight-text">{item}</span>
                    </li>
                  ))}
                </ul>

                <div>
                  <button type="button" data-open-quote class="btn-primary solutions-btn">
                    <span>Orçar projeto residencial</span>
                    <svg class="btn-icon-arrow solutions-btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                </div>
              </div>
            </article>
            
            <div class="solutions-divider"></div>

            <!-- Bloco 2: Empresarial -->
            <article class="solutions-article" aria-labelledby="corp-title">
              <div class="solutions-img-col reveal-scale solutions-img-corp">
                <div class="solutions-img-wrapper">
                  <img 
                    src={asset(siteData.solutions.corporate.image)} 
                    alt={siteData.solutions.corporate.alt} 
                    class="solutions-img"
                    loading="lazy"
                    width="640"
                    height="480"
                  />
                </div>
              </div>

              <div class="solutions-content-col reveal-up solutions-content-corp">
                <span class="solutions-badge">
                  {siteData.solutions.corporate.badge}
                </span>
                <h3 id="corp-title" class="solutions-article-title">
                  {siteData.solutions.corporate.headline}
                </h3>
                <p class="solutions-article-desc">
                  {siteData.solutions.corporate.text}
                </p>

                <ul class="solutions-highlights">
                  {siteData.solutions.corporate.highlights.map((item) => (
                    <li class="solutions-highlight-item">
                      <span class="solutions-highlight-dot solutions-highlight-dot-alt"></span>
                      <span class="solutions-highlight-text">{item}</span>
                    </li>
                  ))}
                </ul>

                <div>
                  <button type="button" data-open-quote class="btn-primary solutions-btn">
                    <span>Orçar projeto empresarial</span>
                    <svg class="btn-icon-arrow solutions-btn-icon-alt" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                </div>
              </div>
            </article>

          </div>

        </div>
      </section>

      <!-- Diferenciais / Padrão de Trabalho -->
      <section id="diferenciais" class="diff-section" aria-labelledby="diferenciais-title">
        <div class="diff-container">
          
          <div class="diff-grid">
            
            <div class="diff-left-col">
              <span class="diff-eyebrow reveal-up">{siteData.differentials.eyebrow}</span>
              <h2 id="diferenciais-title" class="diff-title reveal-up" style="transition-delay: 80ms;">
                {siteData.differentials.headline}
              </h2>
              <p class="diff-desc reveal-up" style="transition-delay: 140ms;">
                {siteData.differentials.description}
              </p>
            </div>

            <!-- Composição Editorial 2x3 -->
            <div class="diff-right-col">
              {siteData.differentials.items.map((diff, idx) => (
                <article class="diff-item reveal-up group" style={`transition-delay: ${Math.floor(idx / 2) * 120}ms;`}>
                  <span class="diff-item-number">{diff.number}</span>
                  <h3 class="diff-item-title">{diff.title}</h3>
                  <p class="diff-item-desc">
                    {diff.description}
                  </p>
                </article>
              ))}
            </div>

          </div>

        </div>
      </section>

      <!-- Projetos Realizados -->
      <!-- Projetos Realizados -->
      <section id="projetos" class="projects-section" aria-labelledby="projetos-title">
        <div class="projects-container">
          
          <div class="projects-header">
            <div>
              <span class="projects-eyebrow reveal-up">{siteData.projects.eyebrow}</span>
              <h2 id="projetos-title" class="projects-title reveal-up" style="transition-delay: 80ms;">
                {siteData.projects.title}
              </h2>
              <p class="projects-desc reveal-up" style="transition-delay: 140ms;">
                {siteData.projects.description}
              </p>
            </div>
          </div>

          <div class="projects-grid">
            {siteData.projects.items.map((proj, idx) => (
              <article class="projects-card reveal-up group" data-project-id={proj.id} style={`transition-delay: ${90 * (idx + 1)}ms;`}>
                <img 
                  src={asset(proj.image)} 
                  alt={proj.alt} 
                  class="projects-card-img"
                  loading="lazy"
                  width="800"
                  height="500"
                />
                <div class="projects-card-overlay">
                  <div class="projects-card-content">
                    <div class="projects-card-meta">
                      <span class="projects-card-category">
                        {proj.category}
                      </span>
                      <span class="projects-card-location">
                        {proj.location}
                      </span>
                    </div>
                    <h3 class="projects-card-title">
                      {proj.title}
                    </h3>
                  </div>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- Sobre Nós -->
      <section id="sobre" class="about-section" aria-labelledby="sobre-title">
        <div class="about-container">
          
          <div class="about-grid">
            
            <div class="about-content-col">
              <span class="about-eyebrow reveal-up">{siteData.about.eyebrow}</span>
              <h2 id="sobre-title" class="about-title reveal-up" style="transition-delay: 80ms;">
                {siteData.about.headline}
              </h2>
              
              <p class="about-copy reveal-up" style="transition-delay: 140ms;">
                {siteData.about.copy}
              </p>

              <div class="about-pillars">
                {siteData.about.pillars.map((pillar, idx) => (
                  <div class="about-pillar reveal-up" style={`transition-delay: ${200 + idx * 70}ms;`}>
                    <h3 class="about-pillar-label">{pillar.label}</h3>
                    <p class="about-pillar-text">
                      {pillar.text}
                    </p>
                  </div>
                ))}
              </div>

              <div class="about-badge reveal-up" style="transition-delay: 350ms;">
                <span class="about-badge-dot"></span>
                <span>Atendimento técnico especializado em {siteData.company.locationString} e região</span>
              </div>
            </div>

            <!-- Lado Visual -->
            <div class="about-visual-col">
              <div class="about-visual-wrapper">
                
                <div class="about-img-main reveal-scale" style="transition-delay: 100ms;">
                  <img 
                    src={asset(siteData.about.image.url)} 
                    alt={siteData.about.image.alt} 
                    class="about-img"
                    loading="lazy"
                    width={siteData.about.image.width}
                    height={siteData.about.image.height}
                  />
                </div>

                <div class="about-img-grid">
                  <div class="about-img-sub reveal-scale group" style="transition-delay: 180ms;">
                    <img 
                      src={asset(siteData.about.facilityImage.url)} 
                      alt={siteData.about.facilityImage.alt} 
                      class="about-img"
                      loading="lazy"
                      width={siteData.about.facilityImage.width}
                      height={siteData.about.facilityImage.height}
                    />
                    <div class="about-img-overlay">
                      <span class="about-img-label">{siteData.about.facilityImage.label}</span>
                    </div>
                  </div>

                  <div class="about-img-sub reveal-scale group" style="transition-delay: 260ms;">
                    <img 
                      src={asset(siteData.about.vehicleImage.url)} 
                      alt={siteData.about.vehicleImage.alt} 
                      class="about-img"
                      loading="lazy"
                      width={siteData.about.vehicleImage.width}
                      height={siteData.about.vehicleImage.height}
                    />
                    <div class="about-img-overlay">
                      <span class="about-img-label">{siteData.about.vehicleImage.label}</span>
                    </div>
                  </div>
                </div>

              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- Depoimentos do Google (Estilo Nadia Richter) -->
      <section id="depoimentos" class="testimonials-section" aria-labelledby="depoimentos-title">
        <div class="testimonials-container">
          
          <!-- Cabeçalho da Seção -->
          <div class="testimonials-header">
            <div class="testimonials-header-left">
              <span class="testimonials-eyebrow reveal-up">
                {siteData.testimonials.eyebrow}
              </span>
              <h2 id="depoimentos-title" class="testimonials-title reveal-up" style="transition-delay: 80ms;">
                {siteData.testimonials.title}
              </h2>
            </div>

            <div class="testimonials-header-right reveal-up" style="transition-delay: 140ms;">
              <p class="testimonials-desc">
                {siteData.testimonials.description}
              </p>
              
              <a 
                href={siteData.company.mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="google-rating-badge"
                title="Ver avaliações no perfil oficial do Google Meu Negócio"
              >
                <!-- Logotipo Oficial Google 'G' 4 Cores -->
                <svg class="google-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.27 21.39 7.35 24 12 24z"/>
                  <path fill="#FBBC05" d="M5.28 14.27a7.2 7.2 0 0 1 0-4.54V6.58H1.25a11.97 11.97 0 0 0 0 10.84l4.03-3.15z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.27 2.61 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                </svg>

                <span class="google-rating-score">{siteData.testimonials.googleRating}</span>

                <!-- 5 estrelas amarelas -->
                <div class="google-rating-stars" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="google-star-icon" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>

                <span class="google-rating-count">{siteData.testimonials.reviewsCount}</span>
              </a>
            </div>
          </div>

          <!-- Grid de Depoimentos (3 colunas no desktop, estilo Nadia Richter) -->
          <div class="testimonials-grid">
            {siteData.testimonials.items.map((item, idx) => (
              <article 
                class="testimonial-card reveal-up"
                style={`transition-delay: ${(idx % 3) * 100}ms;`}
              >
                <div>
                  <!-- Topo do Card: Google G + Estrelas -->
                  <div class="testimonial-card-header">
                    <svg class="google-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.27 21.39 7.35 24 12 24z"/>
                      <path fill="#FBBC05" d="M5.28 14.27a7.2 7.2 0 0 1 0-4.54V6.58H1.25a11.97 11.97 0 0 0 0 10.84l4.03-3.15z"/>
                      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.27 2.61 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                    </svg>
                    <div class="google-rating-stars" aria-hidden="true">
                      {Array.from({ length: item.rating }).map(() => (
                        <svg class="google-star-icon" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      ))}
                    </div>
                  </div>

                  <!-- Conteúdo do Depoimento -->
                  <blockquote class="testimonial-blockquote">
                    "{item.text}"
                  </blockquote>
                </div>

                <!-- Autor e Localização -->
                <div class="testimonial-author-info">
                  <div class="testimonial-author">{item.author}</div>
                  <div class="testimonial-city">{item.city}</div>
                  <div class="testimonial-source">{item.source}</div>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- FAQ Section -->
      <section id="faq" class="faq-section" aria-labelledby="faq-title">
        <div class="faq-container">
          <div class="faq-grid">
            
            <div class="faq-left-col">
              <span class="faq-eyebrow reveal-up">DÚVIDAS FREQUENTES</span>
              <h2 id="faq-title" class="faq-title reveal-up" style="transition-delay: 80ms;">
                Antes de<br class="faq-title-br"/> começar
              </h2>
              <p class="faq-desc reveal-up" style="transition-delay: 120ms;">
                Algumas respostas para deixar sua decisão mais tranquila.
              </p>
            </div>

            <div class="faq-right-col faq-list reveal-fade" style="transition-delay: 140ms;">
            {siteData.faq.map((item, idx) => (
              <details class="faq-details group" open={idx === 0}>
                <summary 
                  class="faq-summary" 
                  id={`faq-trigger-${idx}`} 
                  aria-controls={`faq-content-${idx}`}
                >
                  <span class="faq-summary-title">
                    {item.question}
                  </span>
                  
                  <span class="faq-icon-box">
                    <svg class="faq-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </span>
                </summary>
                
                <div 
                  id={`faq-content-${idx}`} 
                  class="faq-answer" 
                  role="region" 
                  aria-labelledby={`faq-trigger-${idx}`}
                >
                  <p class="faq-answer-text">
                    {item.answer}
                  </p>
                </div>
              </details>
            ))}
          </div>
        </div>
        </div>
      </section>

      <!-- Final CTA Section -->
      <section id="contato" class="cta-final-section" aria-labelledby="cta-final-title">
        <div class="cta-final-container reveal-scale" style="transition-duration: 700ms;">
          
          <span class="cta-final-eyebrow reveal-up" style="transition-delay: 100ms;">
            {siteData.finalCta.eyebrow}
          </span>
          
          <h2 id="cta-final-title" class="cta-final-title reveal-up" style="transition-delay: 180ms;">
            {siteData.finalCta.headline}
          </h2>

          <p class="cta-final-desc reveal-up" style="transition-delay: 260ms;">
            {siteData.finalCta.text}
          </p>

          <div class="cta-final-btn-wrapper reveal-up" style="transition-delay: 340ms;">
            <button type="button" data-open-quote class="btn-primary cta-final-btn">
              <svg class="cta-whatsapp-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>{siteData.finalCta.buttonText}</span>
            </button>
          </div>

          <div class="cta-final-location reveal-fade" style="transition-delay: 420ms;">
            {siteData.finalCta.location}
          </div>

        </div>
      </section>

      <!-- Location Map Section -->
      <section id="mapa" aria-label={`Localização da ${siteData.company.name}`} class="map-section">
        <iframe 
          width="100%" 
          height="100%" 
          frameborder="0" 
          scrolling="no" 
          marginheight="0" 
          marginwidth="0" 
          src={`https://maps.google.com/maps?width=100%25&height=800&hl=pt-BR&q=${encodeURIComponent("Beni Climatização, Ivoti - RS")}&t=&z=15&ie=UTF8&iwloc=B&output=embed`}
          title={`Mapa mostrando a localização da ${siteData.company.name}`}
          class="map-iframe"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </section>

    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-container">
        
        <div class="footer-main-grid">
          
          <!-- Coluna 1: Marca -->
          <div class="footer-col-brand">
            <a href="#" class="footer-logo-link" aria-label={`${siteData.company.name} - Início`}>
              <img 
                src={asset("/assets/images/logo-beni.webp")} 
                alt={siteData.company.name} 
                class="footer-logo-img" 
                width="160" 
                height="78" 
              />
            </a>
            <p class="footer-brand-desc">
              Mais de 4 anos no mercado trazendo conforto, qualidade e confiança em climatização e elétrica residencial em {siteData.company.locationString} e Vale dos Sinos.
            </p>
            <div class="footer-region">
              <span class="footer-region-dot"></span>
              <span>{siteData.company.regionCovered}</span>
            </div>
          </div>

          <!-- Coluna 2: Serviços -->
          <div class="footer-col-nav">
            <h3 class="footer-nav-title">Serviços</h3>
            <ul class="footer-nav-list">
              <li><a href="#servicos" class="footer-nav-link">Instalação de Ar-Condicionado</a></li>
              <li><a href="#servicos" class="footer-nav-link">Higienização Preventiva e Corretiva</a></li>
              <li><a href="#servicos" class="footer-nav-link">Manutenção Corretiva & Diagnóstico</a></li>
              <li><a href="#servicos" class="footer-nav-link">Carga de Gás e Capacitor</a></li>
              <li><a href="#servicos" class="footer-nav-link">Elétrica Residencial Especializada</a></li>
              <li><a href="#solucoes" class="footer-nav-link">Climatização Residencial e Comercial</a></li>
            </ul>
          </div>

          <!-- Coluna 3: Navegação -->
          <div class="footer-col-nav">
            <h3 class="footer-nav-title">Navegação</h3>
            <ul class="footer-nav-list">
              <li><a href="#servicos" class="footer-nav-link">Serviços</a></li>
              <li><a href="#processo" class="footer-nav-link">Como trabalhamos</a></li>
              <li><a href="#instalacao" class="footer-nav-link">Padrão de Instalação</a></li>
              <li><a href="#diferenciais" class="footer-nav-link">Diferenciais</a></li>
              <li><a href="#projetos" class="footer-nav-link">Projetos</a></li>
              <li><a href="#sobre" class="footer-nav-link">Sobre</a></li>
              <li><a href="#depoimentos" class="footer-nav-link">Depoimentos</a></li>
              <li><a href="#faq" class="footer-nav-link">FAQ</a></li>
            </ul>
          </div>

          <!-- Coluna 4: Contato -->
          <div class="footer-col-nav">
            <h3 class="footer-nav-title">Contato</h3>
            <ul class="footer-contact-list">
              <li class="footer-contact-item">
                <span class="footer-contact-label">Local:</span>
                <span>{siteData.company.address.street} - {siteData.company.address.neighborhood}<br />{siteData.company.address.city} / {siteData.company.address.state}</span>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-label">WhatsApp:</span>
                <a href={buildWhatsAppUrl("Olá, Beni Climatização! Gostaria de um atendimento.")} target="_blank" rel="noopener noreferrer" class="footer-contact-link-highlight">
                  {siteData.company.whatsapp}
                </a>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-label">E-mail:</span>
                <a href={`mailto:${siteData.company.email}`} class="footer-contact-link">
                  {siteData.company.email}
                </a>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-label">Instagram:</span>
                <a href={siteData.company.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
                  {siteData.company.instagram}
                </a>
              </li>
              <li class="footer-contact-hours">
                {siteData.company.hours.weekdays}<br />{siteData.company.hours.saturday}
              </li>
            </ul>
          </div>

        </div>

        <!-- Rodapé Inferior -->
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} {siteData.company.name}. Todos os direitos reservados. {siteData.company.locationString}.</p>
          <div class="footer-legal">
            <a href="#" class="footer-legal-link">Política de Privacidade</a>
            <a href="#" class="footer-legal-link">Termos de Uso</a>
          </div>
        </div>

      </div>


    </footer>

    <!-- Floating WhatsApp CTA (Exato Pedro Zvir) -->
    <a
      class="floating-whatsapp"
      href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá,%20Beni%20Climatização!%20Gostaria%20de%20solicitar%20um%20orçamento.`}
      target="_blank"
      rel="noreferrer"
      aria-label="Falar com a Beni Climatização pelo WhatsApp"
    >
      <img src={asset("/assets/images/whatsapp.webp")} alt="WhatsApp" width="60" height="60" />
    </a>

    <!-- Wizard de qualificação em etapas → WhatsApp -->
    <QuoteWizard />

  </div>
</BaseLayout>
