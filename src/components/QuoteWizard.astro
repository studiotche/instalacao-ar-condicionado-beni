---
import { siteData, quoteFunnel } from "../data/site";
---

<div id="quote-modal-backdrop" class="modal-backdrop" aria-hidden="true"></div>

<div
  id="quote-modal"
  class="modal-container"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wizard-title"
>
  <div class="modal-content wizard-content">
    <div class="modal-header wizard-header">
      <div>
        <span class="modal-eyebrow">Pré-orçamento • {siteData.company.name}</span>
        <h3 id="wizard-title" class="modal-title">Monte seu orçamento em 1 minuto</h3>
      </div>
      <button id="close-quote-modal" type="button" class="modal-close-btn" aria-label="Fechar formulário">
        <svg class="modal-close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="wizard-progress" aria-hidden="true">
      <div class="wizard-progress-track">
        <div id="wizard-progress-fill" class="wizard-progress-fill" style="width: 14%"></div>
      </div>
      <div class="wizard-progress-meta">
        <span id="wizard-step-label">Etapa 1 de 7</span>
        <span id="wizard-percent-label">14%</span>
      </div>
    </div>

    <div id="wizard-steps" aria-live="polite">
      <!-- ETAPA 1: Serviço -->
      <section class="wizard-step is-active" data-wizard-step="1" aria-label="Etapa 1: serviço">
        <p class="wizard-question">Qual serviço você precisa?</p>
        <div class="wizard-grid wizard-grid-2">
          {quoteFunnel.services.map((opt) => (
            <button type="button" class="wizard-option" data-group="service" data-value={opt.value}>
              <span class="wizard-option-label">{opt.label}</span>
              {opt.hint && <span class="wizard-option-hint">{opt.hint}</span>}
            </button>
          ))}
        </div>
      </section>

      <!-- ETAPA 2: Imóvel -->
      <section class="wizard-step" data-wizard-step="2" aria-label="Etapa 2: tipo de imóvel" hidden>
        <p class="wizard-question">Onde será o serviço?</p>
        <div class="wizard-grid wizard-grid-2">
          {quoteFunnel.propertyTypes.map((opt) => (
            <button type="button" class="wizard-option" data-group="property" data-value={opt.value}>
              <span class="wizard-option-label">{opt.label}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- ETAPA 3: Detalhe condicional -->
      <section class="wizard-step" data-wizard-step="3" aria-label="Etapa 3: detalhes" hidden>
        <p class="wizard-question">Conte um pouco mais</p>

        <div class="wizard-conditional" data-conditional="instalacao" hidden>
          <p class="wizard-sublabel">Você já tem o aparelho?</p>
          <div class="wizard-grid wizard-grid-2">
            {quoteFunnel.installOwnership.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail1" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
          <p class="wizard-sublabel">Quantos ambientes?</p>
          <div class="wizard-grid wizard-grid-3">
            {quoteFunnel.roomCounts.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail2" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="wizard-conditional" data-conditional="manutencao" hidden>
          <p class="wizard-sublabel">O que está acontecendo?</p>
          <div class="wizard-grid wizard-grid-2">
            {quoteFunnel.maintenanceIssues.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail1" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
          <label class="wizard-field">
            <span class="wizard-sublabel">Há quanto tempo? (opcional)</span>
            <input type="text" id="wizard-detail2-text" class="wizard-input" placeholder="Ex: há 3 dias, há 2 semanas" maxlength="80" />
          </label>
        </div>

        <div class="wizard-conditional" data-conditional="higienizacao" hidden>
          <p class="wizard-sublabel">Quantos aparelhos?</p>
          <div class="wizard-grid wizard-grid-3">
            {quoteFunnel.hygieneCounts.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail1" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
          <p class="wizard-sublabel">Última limpeza?</p>
          <div class="wizard-grid wizard-grid-3">
            {quoteFunnel.lastCleaning.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail2" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="wizard-conditional" data-conditional="comercial" hidden>
          <p class="wizard-sublabel">Qual o porte?</p>
          <div class="wizard-grid wizard-grid-2">
            {quoteFunnel.commercialSizes.map((opt) => (
              <button type="button" class="wizard-option" data-group="detail1" data-value={opt.value}>
                <span class="wizard-option-label">{opt.label}</span>
              </button>
            ))}
          </div>
          <label class="wizard-field">
            <span class="wizard-sublabel">Observação técnica (opcional)</span>
            <input type="text" id="wizard-detail2-text-com" class="wizard-input" placeholder="Ex: 2 splits + 1 VRF, PMOC vencido" maxlength="100" />
          </label>
        </div>

        <div class="wizard-conditional" data-conditional="generico" hidden>
          <label class="wizard-field">
            <span class="wizard-sublabel">Descreva rapidamente (opcional)</span>
            <input type="text" id="wizard-detail1-text" class="wizard-input" placeholder="Ex: aparelho de 12.000 BTUs para a sala" maxlength="100" />
          </label>
        </div>
      </section>

      <!-- ETAPA 4: Urgência -->
      <section class="wizard-step" data-wizard-step="4" aria-label="Etapa 4: urgência" hidden>
        <p class="wizard-question">Qual a urgência?</p>
        <div class="wizard-grid wizard-grid-1">
          {quoteFunnel.urgencies.map((opt) => (
            <button type="button" class="wizard-option wizard-option-row" data-group="urgency" data-value={opt.value}>
              <span class="wizard-option-label">{opt.label}</span>
              {opt.hint && <span class="wizard-option-hint">{opt.hint}</span>}
            </button>
          ))}
        </div>
      </section>

      <!-- ETAPA 5: Localização -->
      <section class="wizard-step" data-wizard-step="5" aria-label="Etapa 5: localização" hidden>
        <p class="wizard-question">Onde é o atendimento?</p>
        <div class="wizard-fields">
          <label class="wizard-field">
            <span class="wizard-sublabel">Cidade *</span>
            <select id="wizard-city" class="wizard-input" required>
              <option value="">Selecione…</option>
              {quoteFunnel.cities.map((city) => (
                <option value={city} selected={city === "Ivoti"}>{city}</option>
              ))}
            </select>
          </label>
          <label class="wizard-field">
            <span class="wizard-sublabel">Bairro *</span>
            <input type="text" id="wizard-district" class="wizard-input" placeholder="Ex: Centro" maxlength="60" autocomplete="address-level3" />
          </label>
        </div>
      </section>

      <!-- ETAPA 6: Contato -->
      <section class="wizard-step" data-wizard-step="6" aria-label="Etapa 6: seus dados" hidden>
        <p class="wizard-question">Como te chamamos no WhatsApp?</p>
        <div class="wizard-fields">
          <label class="wizard-field">
            <span class="wizard-sublabel">Seu nome *</span>
            <input type="text" id="wizard-name" class="wizard-input" placeholder="Ex: João Silva" maxlength="60" autocomplete="name" />
          </label>
          <label class="wizard-field">
            <span class="wizard-sublabel">Seu WhatsApp *</span>
            <input type="tel" id="wizard-phone" class="wizard-input" placeholder="(51) 99999-9999" inputmode="tel" autocomplete="tel" maxlength="16" />
          </label>
          <label class="wizard-consent">
            <input type="checkbox" id="wizard-lgpd" checked />
            <span>Autorizo ser chamado(a) no WhatsApp pela Beni Climatização sobre este orçamento.</span>
          </label>
        </div>
      </section>

      <!-- ETAPA 7: Revisão -->
      <section class="wizard-step" data-wizard-step="7" aria-label="Etapa 7: revisão" hidden>
        <p class="wizard-question">Confira e envie</p>
        <ul id="wizard-summary" class="wizard-summary"></ul>
        <div class="wizard-send-group">
          <button type="button" id="wizard-send" class="btn-primary wizard-send-btn">
            <svg class="modal-whatsapp-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Enviar no WhatsApp</span>
          </button>
          <button type="button" id="wizard-copy" class="wizard-link-btn">Copiar resumo</button>
          <p class="modal-submit-help">Abre o WhatsApp com a mensagem pronta — é só confirmar o envio.</p>
        </div>
      </section>
    </div>

    <p id="wizard-error" class="wizard-error" role="alert" hidden></p>

    <div class="wizard-nav">
      <button type="button" id="wizard-back" class="wizard-back-btn" hidden>← Voltar</button>
      <button type="button" id="wizard-next" class="btn-primary wizard-next-btn">Continuar →</button>
    </div>
  </div>
</div>
