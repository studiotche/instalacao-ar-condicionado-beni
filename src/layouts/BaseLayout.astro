---
import "../styles/global.css";
import { siteData } from "../data/site";

interface Props {
  readonly title?: string;
  readonly description?: string;
}

const {
  title = siteData.seo.title,
  description = siteData.seo.description,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string): string => `${base}${path.replace(/^\//, "")}`;

// Open Graph exige URL absoluta: técnico instalando split (hero mobile) em 1200x630 JPEG.
const ogImageUrl = new URL(asset(siteData.seo.ogImage), siteData.seo.canonicalUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HVACBusiness",
      "@id": "https://beniclimatizacao.com.br/#business",
      "name": "Beni Climatização",
      "legalName": "Beni Climatização Ltda",
      "url": siteData.seo.canonicalUrl,
      "logo": asset(siteData.seo.ogImage),
      "image": asset(siteData.hero.image.url),
      "description": "Mais de 4 anos de experiência em instalação, manutenção, higienização de ar-condicionado, carga de gás, capacitor e elétrica residencial em Ivoti e região.",
      "telephone": "+5551993482670",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Santa Rita, 282",
        "addressLocality": "Ivoti",
        "addressRegion": "RS",
        "postalCode": "93900-000",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -29.6057596,
        "longitude": -51.1560729
      },
      "areaServed": [
        { "@type": "City", "name": "Ivoti" },
        { "@type": "City", "name": "Dois Irmãos" },
        { "@type": "City", "name": "Estância Velha" },
        { "@type": "City", "name": "Novo Hamburgo" },
        { "@type": "AdministrativeArea", "name": "Vale dos Sinos e Encosta da Serra - RS" }
      ],
      "priceRange": "$$",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços de Climatização Beni Climatização",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Instalação de Ar-Condicionado em Ivoti",
              "description": "Instalação Split e Inverter com tubulação em cobre, vácuo com vacuômetro e acabamento alinhado."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Higienização Preventiva e Limpeza Química",
              "description": "Higienização com máquina pressurizada e bactericida especial contra ácaros, fungos e odores."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Carga de Gás e Troca de Capacitor",
              "description": "Medição de pressão com manifold digital, reposição de fluido refrigerante e teste de capacitor."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Elétrica Residencial Especializada",
              "description": "Instalação de circuitos dedicados, disjuntores e tomadas para ar-condicionado com total segurança."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://beniclimatizacao.com.br/#faq",
      "mainEntity": siteData.faq.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags Oficiais -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteData.seo.keywords} />
    <meta name="author" content="Beni Climatização" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={siteData.seo.canonicalUrl} />
    <meta name="geo.region" content="BR-RS" />
    <meta name="geo.placename" content="Ivoti" />

    <!-- OpenGraph / Social Meta -->
    <meta property="og:site_name" content="Beni Climatização" />
    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteData.seo.canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={asset(siteData.seo.ogImage)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={asset(siteData.seo.ogImage)} />

    <!-- Favicon Oficial Beni Climatização -->
    <link rel="icon" type="image/webp" href={asset("/assets/images/favicon.webp")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("/apple-touch-icon.png")} />

    <!-- Preload das Imagens e Fontes do Hero (LCP Optimization) -->
    <link rel="preload" href={asset("/assets/fonts/PlusJakartaSans-Bold.woff2")} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" as="image" href={asset(siteData.hero.image.url)} media="(min-width: 761px)" fetchpriority="high" />
    <link rel="preload" as="image" href={asset(siteData.hero.imageMobile.url)} media="(max-width: 760px)" fetchpriority="high" />

    <!-- Google Fonts removido em favor do auto-hospedado no global.css -->
    <!-- Pré-hide síncrono da hero (anti-flash): só desktop; auto-remove em 3s contra falha do bundle -->
    <script is:inline>
      try {
        if (window.matchMedia("(min-width: 761px)").matches) {
          document.documentElement.classList.add("hero-pending");
          window.setTimeout(function () {
            document.documentElement.classList.remove("hero-pending");
          }, 3000);
        }
      } catch (e) {}
    </script>
    <!-- Schema.org JSON-LD Structured Data: LocalBusiness, Services & FAQPage -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body class="site-body">
    <slot />
    <script src="../scripts/site-interactions.ts"></script>
    <script src="../scripts/quote-wizard.ts"></script>
    <script src="../scripts/smooth-scroll.ts"></script>
  </body>
</html>
